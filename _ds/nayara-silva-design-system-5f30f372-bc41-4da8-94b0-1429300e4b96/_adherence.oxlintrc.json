{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/case/**",
              "components/foundation/**",
              "components/index/**",
              "components/site/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:dir|style|key|ref|className|style|children)$/]",
        "message": "<Arrow> doesn't accept that prop. Declared props: dir, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Arrow'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:right|left|down|up)$/]",
        "message": "<Arrow> dir must be one of 'right' | 'left' | 'down' | 'up'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|bleed|style|key|ref|className|style|children)$/]",
        "message": "<Band> doesn't accept that prop. Declared props: children, tone, bleed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Band'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|band|inverse)$/]",
        "message": "<Band> tone must be one of 'paper' | 'band' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|variant|arrow|as|style|key|ref|className|style|children)$/]",
        "message": "<ButtonLink> doesn't accept that prop. Declared props: children, href, variant, arrow, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonLink'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outline|inverse|quiet)$/]",
        "message": "<ButtonLink> variant must be one of 'solid' | 'outline' | 'inverse' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselSlide'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|name|children|slotId|src|style|key|ref|className|style|children)$/]",
        "message": "<CarouselSlide> doesn't accept that prop. Declared props: count, name, children, slotId, src, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:meta|title|deck|backHref|backLabel|style|key|ref|className|style|children)$/]",
        "message": "<CaseHero> doesn't accept that prop. Declared props: meta, title, deck, backHref, backLabel, style."
