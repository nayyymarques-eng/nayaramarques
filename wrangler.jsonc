// Cloudflare Worker config: static site, deployed on every push to main.
{
  "name": "nayaramarques",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  // Worker Previews: every branch and pull request gets its own preview URL (npx wrangler preview).
  "previews": {},
  "routes": [
    { "pattern": "nayaramarques.com", "custom_domain": true },
    { "pattern": "www.nayaramarques.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
